# 复制成 .env 再按需填写(.env 不会提交到 git)。全部可选,不填就用公共节点 / 不推送。

# 查链上历史事件用的节点(扫链、K 线、成交记录)。
# 不填:先用 publicnode(只能查最近约 1 小时),再用 48.club(慢,但能查更早的)。
# 想查全历史、更快:填你自己的节点,比如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>
BSC_LOG_RPC=

# 读链(余额、报价、等回执)用的节点,不填用 https://bsc-dataseed.bnbchain.org
BSC_RPC=

# 实时推送用的 WebSocket 节点,不填用 wss://bsc-rpc.publicnode.com
BSC_WSS=

# Telegram 推送(发射后自动转出、自动领取、Gang 持仓提醒)。不填就只在网页上和日志里显示
TG_BOT_TOKEN=
TG_CHAT_ID=

# 底池币兑换前的流动性门槛(美元),最深的池子低于这个值就不换,默认 20000
QUOTE_MIN_LIQ_USD=

# 代理:网络连不上 www.binance.com(登录、下单会报 Connect Timeout)时填。
# 不填会自动用 Windows 系统代理(Clash / v2rayN 打开「系统代理」即可);想手动指定就填,比如 Clash: http://127.0.0.1:7890,v2rayN: http://127.0.0.1:10809
HTTPS_PROXY=
